# Copy this file to .env and fill in what you want. Every line below is
# optional -- the site runs with none of this set. Real environment
# variables (e.g. ones a hosting provider sets for you) always win over
# whatever is in .env.

# auto (default, recommended) | live | demo -- see README.md "Data modes"
STOCKGRAPH_DATA_MODE=auto

# Turns on the AI narrative on forecast pages + the chat widget. Get a key
# at console.anthropic.com. Leave blank and both features just say they're
# not turned on yet -- nothing breaks.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a real, descriptive User-Agent (name + contact email)
# on every request, or it 403s. Only needed for live filings data.
SEC_USER_AGENT=Lumina Advisors (contact: you@example.com)

# Optional: a free Finnhub key (finnhub.io/register, no card) makes
# earnings/fundamentals fetch through a real API instead of Yahoo's
# undocumented endpoint. Without it, Yahoo/demo is used as before.
STOCKGRAPH_FINNHUB_API_KEY=

# Optional: paper-trading. Turns today's top-confidence forecasts into
# SIMULATED orders on a free Alpaca (alpaca.markets) paper-trading account
# -- real API, fake money, no funding or approval needed. Get keys at
# alpaca.markets -> sign up -> Paper Trading tab -> "Generate New Keys".
# Leave blank (or leave STOCKGRAPH_TRADING_ENABLED unset) and this whole
# feature stays off -- nothing about the site changes. See README.md
# "Paper trading" before turning this on.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
STOCKGRAPH_TRADING_ENABLED=false
# STOCKGRAPH_TRADING_HORIZON_DAYS=1
# STOCKGRAPH_TRADING_MIN_CONFIDENCE=0.6
# STOCKGRAPH_TRADING_MAX_POSITIONS=5
# STOCKGRAPH_TRADING_POSITION_USD=500
# STOCKGRAPH_TRADING_MAX_DAILY_LOSS_PCT=0.03

# Optional: "What to invest in" recommendation engine tuning -- ranks and
# sizes picks from the forecasts/track record already computed elsewhere.
# Recommend-only, never places an order. Sensible defaults if left unset;
# see README.md "What to invest in".
# STOCKGRAPH_RECO_MAX_PICKS=10
# STOCKGRAPH_RECO_DEFAULT_HORIZON=5
# STOCKGRAPH_RECO_MAX_POSITION_PCT=0.25
# STOCKGRAPH_RECO_CASH_RESERVE_PCT=0.10
# STOCKGRAPH_RECO_MIN_CONFIDENCE=0.0
# STOCKGRAPH_RECO_MIN_MOVE_PCT=0.0
# STOCKGRAPH_RECO_DEFAULT_PORTFOLIO_USD=10000

# Rarely need to touch these:
# STOCKGRAPH_HOST=0.0.0.0
# STOCKGRAPH_PORT=8000
# STOCKGRAPH_DB=data/stockgraph.db
# STOCKGRAPH_HTTP_TIMEOUT=10
# STOCKGRAPH_PRICE_DAYS=400
